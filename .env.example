# Shakambhari Enterprises - Environment Configuration
# ====================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=shakambhari

# Google Cloud Storage bucket name for PDF/XLSX and template storage
GCS_BUCKET_NAME=shakambhari-invoices-bucket

# Google Spreadsheet ID for real-time ledger & buyer profiles
# URL format: https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
SPREADSHEET_ID=your-spreadsheet-id-here

# Application Login Password (protects public web app)
APP_PASSWORD=your-secure-password

# Google Gemini Vision API Key (Get a 100% free key at https://aistudio.google.com/apikey)
# Powers the rough slip scanner, weight chit reader & visiting card parser
GEMINI_API_KEY=your-gemini-api-key-here

# Flask secret key (random 32-char hex string for session security)
FLASK_SECRET_KEY=generate-a-random-hex-string-for-production
SECRET_KEY=generate-a-random-hex-string-for-production

# Path to service account JSON credentials (for local dev with GCP services)
# On Cloud Run, IAM service account authentication is handled automatically
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Environment mode ('development' or 'production')
FLASK_ENV=production
SESSION_COOKIE_SECURE=false
